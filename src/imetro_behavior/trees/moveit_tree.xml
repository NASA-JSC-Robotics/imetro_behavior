<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Sequence">
      <SubTree ID="MoveCartesian" name="MoveCartesian"/>
      <SubTree ID="MoveToPose" name="MoveToPose"/>
      <SubTree ID="MoveToHome" name="MoveToHome"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveCartesian">
    <Sequence name="Sequence">
      <CreatePoseStamped
        name="set_target_pose"
        position_xyz="0.212, 0.786, 1.501"
        orientation_xyzw="0.531, 0.845, 0.015, -0.056"
        frame="phoebe_base_link"
        msg="{waypoints}"
      />
      <PlanCartesian
        name="plan_cartesian"
        service_name="/phoebe/compute_cartesian_path"
        group_name="left_lift_ur"
        waypoints="{waypoints}"
        trajectory="{trajectory}"
      />
      <RequestTrajectoryApproval
        name="preview_trajectory"
        action_name="/phoebe/preview_trajectory"
        trajectory="{trajectory}"
      />
      <ExecuteTrajectoryBehavior
        name="execute_trajectory"
        action_name="/phoebe/execute_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveToPose">
    <Sequence name="Sequence">
      <CreatePoseStamped
        name="set_target_pose"
        position_xyz="6.632, 0.880, 1.627"
        orientation_xyzw="0.880, -0.032, -0.022, 0.473"
        frame="world"
        msg="{target_pose}"
      />
      <PlanToPose
        name="plan_to_home"
        service_name="/clr/plan_kinematic_path"
        pipeline="ompl"
        planner="RRTConnect"
        group_name="chonkur_grasp"
        target_frame="clr_grasp_frame"
        target_pose="{target_pose}"
        position_tolerance="0.005"
        orientation_tolerance="0.005, 0.005, 0.005"
        trajectory="{trajectory}"
      />
      <RequestTrajectoryApproval
        name="preview_trajectory"
        action_name="/clr/preview_trajectory"
        trajectory="{trajectory}"
      />
      <ExecuteTrajectoryBehavior
        name="execute_trajectory"
        action_name="/clr/execute_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveToHome">
    <Sequence name="Sequence">
      <JointNamesAndPositionsFromYaml
        name="get_home_state"
        package_name="imetro_behavior"
        yaml_file="config/example_joint_states.yaml"
        state_name="clr_home"
        joint_names="{joint_names}"
        joint_positions="{joint_positions}"
      />
      <PlanToJointState
        name="plan_to_home"
        service_name="/clr/plan_kinematic_path"
        pipeline="ompl"
        planner="RRTConnect"
        group_name="chonkur_grasp"
        joint_names="{joint_names}"
        joint_positions="{joint_positions}"
        tolerance="0.005"
        trajectory="{trajectory}"
      />
      <RequestTrajectoryApproval
        name="preview_trajectory"
        action_name="/clr/preview_trajectory"
        trajectory="{trajectory}"
      />
      <ExecuteTrajectoryBehavior
        name="execute_trajectory"
        action_name="/clr/execute_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>
</root>
