<root main_tree_to_execute="MainTree">
  <!-- Top-level behavior tree -->
  <BehaviorTree ID="MainTree">
    <Sequence name="Sequence">
      <CreatePoseStamped name="setup_pose"
        position_xyz="0.895, -0.580, 1.593"
        orientation_wxyz="0.630, 0.603, 0.345, 0.346"
        frame="phoebe_base_link"
        msg="{setup_pose}"
      />
      <SubTree ID="MovePhoebeToPose" name="MoveToSetup"
        pipeline="ompl"
        planner="RRTConnect"
        group_name="right_lift_ur"
        target_frame="phoebe_right_grasp_frame"
        target_pose="{setup_pose}"
        max_velocity_scaling="1.0"
        max_acceleration_scaling="1.0"
      />
      <CreatePoseStamped name="grasp_start_pose"
        position_xyz="0.513, -0.509, 0.663"
        orientation_wxyz="0.654, 0.656, 0.266, 0.267"
        frame="phoebe_base_link"
        msg="{start_pose}"
      />
      <SubTree ID="MovePhoebeToPose" name="MoveToStart"
        pipeline="ompl"
        planner="RRTConnect"
        group_name="right_lift_ur"
        target_frame="phoebe_right_grasp_frame"
        target_pose="{start_pose}"
        max_velocity_scaling="1.0"
        max_acceleration_scaling="1.0"
      />
      <CreatePoseStamped name="arc_center_pose"
        position_xyz="0.897, -0.903, 0.662"
        orientation_wxyz="0.654, 0.656, 0.266, 0.267"
        frame="phoebe_base_link"
        msg="{arc_center}"
      />
      <!-- Plan and execute arc path -->
      <PlanArcPath name="TestPlanArcPath"
        service_name="/phoebe/plan_kinematic_path"
        fixed_frame="phoebe_base_link"
        group_name="right_grasp"
        target_frame="phoebe_right_grasp_frame"
        rotation_pose="{arc_center}"
        rotation_axis_xyz="1.0, 0.0, 0.0"
        rotation_amount_rad = "1.57"
        keep_start_orientation = "true"
        position_tolerance = "0.01"
        orientation_tolerance_xyz = "0.1, 0.1, 0.1"
        max_velocity_scaling = "1.0"
        max_acceleration_scaling = "0.05"
        trajectory = "{arc_trajectory}"
      />
      <ExecuteTrajectoryBehavior name="execute_arc_path"
        action_name="/phoebe/execute_trajectory"
        trajectory="{arc_trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <!-- Manipulation Trees -->
  <BehaviorTree ID="MovePhoebeToJoint">
    <Sequence name="Sequence">
      <PlanToJointState
        name="plan_to_joint"
        service_name="/phoebe/plan_kinematic_path"
        pipeline="{pipeline}"
        planner="{planner}"
        group_name="{group_name}"
        joint_names="{joint_names}"
        joint_positions="{joint_positions}"
        tolerance="0.005"
        trajectory="{trajectory}"
      />
      <ExecuteTrajectoryBehavior
        name="execute_trajectory"
        action_name="/phoebe/execute_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MovePhoebeToPose">
    <Sequence name="Sequence">
      <PlanToPose
        name="plan_to_pose"
        service_name="/phoebe/plan_kinematic_path"
        pipeline="{pipeline}"
        planner="{planner}"
        group_name="{group_name}"
        target_frame="{target_frame}"
        target_pose="{target_pose}"
        position_tolerance="0.01"
        orientation_tolerance="0.01, 0.01, 0.01"
        trajectory="{trajectory}"
      />
      <ExecuteTrajectoryBehavior
        name="execute_trajectory"
        action_name="/phoebe/execute_trajectory"
        trajectory="{trajectory}"
      />
    </Sequence>
  </BehaviorTree>

</root>
